model CrmCountyTracking {
  id                Int                        @id @default(autoincrement())
  scope             CrmCoverageScope           @default(COUNTY)
  state             String
  county            String?
  authorityLevel    CrmFilingAuthorityLevel    @default(COUNTY)
  authorityType     CrmFilingAuthorityType     @default(COUNTY_CLERK)
  authorityName     String?
  normalizedName    String?
  contactEmail      String?
  coverageKey       String                     @unique
  status            CrmCountyAcquisitionStatus @default(NOT_STARTED)
  notes             String?                    @db.Text
  sourceType        CrmAuthoritySourceType     @default(MANUAL)
  sourceConfidence  CrmSourceConfidence        @default(MEDIUM)
  sourceCapturedAt  DateTime?
  lastNormalizedAt  DateTime?
  currentSourceNote String?                    @db.Text
  updatedAt         DateTime                   @updatedAt
  aliases           CrmFilingAuthorityAlias[]
  contacts          CountyClerk[]
  crmCandidates     CrmCandidate[]
  elections         Election[]

  @@index([state, scope])
  @@index([state, county, scope])
  @@index([state, authorityLevel, authorityType])
}

model CountyClerk {
  id                  Int                    @id @default(autoincrement())
  firstName           String?
  lastName            String?
  email               String
  county              String?
  state               String
  jurisdiction        String?
  phone               String?
  notes               String?                @db.Text
  authorityTrackingId Int?
  authorityName       String?
  authorityAlias      String?
  sourceType          CrmAuthoritySourceType @default(MANUAL)
  sourceConfidence    CrmSourceConfidence    @default(MEDIUM)
  sourceCapturedAt    DateTime?
  lastNormalizedAt    DateTime?
  status              CrmContactStatus       @default(NOT_CONTACTED)
  needsFollowUp       Boolean                @default(false)
  followUpDate        DateTime?
  aiDraftResponse     String?                @db.Text
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  authorityTracking   CrmCountyTracking?     @relation(fields: [authorityTrackingId], references: [id])
  emailLogs           CrmEmailLog[]
  crmCandidates       CrmCandidate[]
  intakeSubmissions   CrmIntakeSubmission[]

  @@index([authorityTrackingId])
}

model CrmCandidate {
  id                       Int                    @id @default(autoincrement())
  firstName                String
  lastName                 String
  outreachEmail            String
  signupEmail              String?
  phone                    String?
  county                   String?
  state                    String?
  position                 String?
  municipality             String?
  party                    String?
  tag                      String?
  manualSend               Boolean                @default(false)
  notes                    String?                @db.Text
  status                   CrmContactStatus       @default(NOT_CONTACTED)
  needsFollowUp            Boolean                @default(false)
  followUpDate             DateTime?
  sourceClerkId            Int?
  filingAuthorityId        Int?
  sourceIntakeSubmissionId Int?
  candidateId              Int?
  candidateSlug            String?
  canonicalCandidateKey    String?
  sourceType               CrmAuthoritySourceType @default(MANUAL)
  sourceConfidence         CrmSourceConfidence    @default(MEDIUM)
  sourceCapturedAt         DateTime?
  lastNormalizedAt         DateTime?
  matchAuditJson           Json?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  sourceClerk              CountyClerk?           @relation(fields: [sourceClerkId], references: [id])
  filingAuthority          CrmCountyTracking?     @relation(fields: [filingAuthorityId], references: [id])
  sourceIntakeSubmission   CrmIntakeSubmission?   @relation("SubmissionPromotedCandidates", fields: [sourceIntakeSubmissionId], references: [id])
  emailLogs                CrmEmailLog[]

  @@index([filingAuthorityId])
  @@index([canonicalCandidateKey])
}

model CrmOrganization {
