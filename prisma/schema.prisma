model CrmIntakeSubmission {
  id                       Int                         @id @default(autoincrement())
  sourceType               CrmIntakeSourceType
  status                   CrmIntakeSubmissionStatus   @default(RECEIVED)
  clerkId                  Int?
  uploaderEmail            String?
  targetScope              CrmCoverageScope?
  targetState              String?
  targetCounty             String?
  targetAuthorityLevel     CrmFilingAuthorityLevel?
  targetAuthorityType      CrmFilingAuthorityType?
  targetAuthorityName      String?
  targetFilingAuthorityKey String?
  targetMapRegionId        Int?
  targetMapRegionType      String?
  targetMapRegionCode      String?
  targetMapRegionLabel     String?
  defaultMunicipality      String?
  defaultYear              String?
  sheetDescription         String?                     @db.Text
  uploadElectionTerm       String?
  rawSubject               String?
  rawText                  String?                     @db.Text
  rawHtml                  String?                     @db.Text
  replyMode                CrmIntakeReplyMode          @default(NONE)
  pipelineMode             CrmIntakePipelineMode       @default(SKIP)
  suggestedCoverageStatus  CrmCountyAcquisitionStatus?
  suggestedReplyDraft      String?                     @db.Text
  suggestedSummary         String?                     @db.Text
  sourceConfidence         CrmSourceConfidence         @default(MEDIUM)
  sourceCapturedAt         DateTime?
  lastNormalizedAt         DateTime?
  normalizationJson        Json?
  photoPreviewJson         Json?
  importResultJson         Json?
  parseError               String?                     @db.Text
  reviewNotes              String?                     @db.Text
  reviewedByUserId         String?
  reviewedAt               DateTime?
  promotionUploadId        String?
  receivedAt               DateTime                    @default(now())
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  clerk                    CountyClerk?                @relation(fields: [clerkId], references: [id])
  promotionUpload          SpreadsheetUpload?          @relation(fields: [promotionUploadId], references: [id])
  targetMapRegion          ElectionMapRegion?          @relation(fields: [targetMapRegionId], references: [id])
